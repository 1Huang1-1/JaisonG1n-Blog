---
import { Icon } from "astro-icon/components";
import ResourceIcon from "./ResourceIcon.astro";
import { learningIcons } from "../../../data/resource-icons";

const { item } = Astro.props;
const icon = item.icon || learningIcons[item.type] || "material-symbols:bookmark";
const hasUnits = item.totalUnits > 0;
const progressLabel = hasUnits ? `${item.progress} / ${item.totalUnits}` : item.progress > 0 ? `已完成 ${item.progress} 个单元` : "";
---

<article class="card-base flex h-full w-full min-w-0 flex-col gap-4 p-5 transition hover:-translate-y-0.5">
	<div class="flex min-w-0 items-start gap-4">
		<ResourceIcon image={item.cover} icon={icon} fallback="material-symbols:bookmark" alt={item.title} />
		<div class="min-w-0 flex-1">
			<h2 class="line-clamp-2 text-lg font-bold">{item.title}</h2>
			<p class="mt-1 text-sm text-black/55 dark:text-white/55">{item.type} · {item.status}{item.author ? ` · ${item.author}` : ""}</p>
		</div>
		{item.rating > 0 && <span class="shrink-0 rounded-full bg-(--btn-regular-bg) px-2.5 py-1 text-xs text-(--primary)">{item.rating.toFixed(1)}</span>}
	</div>
	<p class="line-clamp-3 text-sm leading-6 text-black/70 dark:text-white/70">{item.description}</p>
	{progressLabel && <div class="flex items-center gap-2 text-sm text-black/65 dark:text-white/65"><Icon name="material-symbols:progress-activity" class="h-4 w-4 text-(--primary)" />{progressLabel}</div>}
	{item.tags?.length > 0 && <div class="flex flex-wrap gap-2">{item.tags.map((tag: string) => <span class="rounded-full bg-(--btn-regular-bg) px-2 py-1 text-xs">{tag}</span>)}</div>}
	<div class="mt-auto flex flex-wrap gap-2 pt-1">
		{item.sourceUrl && <a class="btn-regular inline-flex items-center gap-1.5 text-sm focus-visible:outline-2 focus-visible:outline-(--primary)" href={item.sourceUrl} target="_blank" rel="noopener noreferrer"><Icon name="material-symbols:open-in-new" class="h-4 w-4" />原始资料</a>}
		{item.relatedPost && <a class="btn-regular inline-flex items-center gap-1.5 text-sm focus-visible:outline-2 focus-visible:outline-(--primary)" href={item.relatedPost.path}><Icon name="material-symbols:article-outline" class="h-4 w-4" />查看学习笔记</a>}
	</div>
</article>
