---
import { Icon } from "astro-icon/components";

import type { MomentCardProps } from "./types";

const { moment, title, detailHref, viewLabel, moodLabel, imageLabel } =
	Astro.props as MomentCardProps;
const previewImages = moment.images.slice(0, 3);
const getImageUrl = (image: (typeof moment.images)[number]) =>
	image.src || image.url || "";
const dateLabel = new Date(`${moment.date}T00:00:00Z`).toLocaleDateString(
	"zh-CN",
	{
		year: "numeric",
		month: "short",
		day: "numeric",
	},
);
---

<article class="moment-card group relative overflow-hidden rounded-xl border border-black/10 bg-transparent transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" data-tags={moment.tags.join(",")}>
	<div class="p-5">
		<div class="mb-2 flex items-start justify-between gap-3">
			<h2 class="min-w-0 break-words text-lg font-semibold text-black/90 dark:text-white/90">{title}</h2>
			<time class="shrink-0 text-xs text-black/50 dark:text-white/50" datetime={moment.date}>{dateLabel}</time>
		</div>
		<p class="mb-3 line-clamp-3 text-sm leading-relaxed text-black/70 dark:text-white/70">{moment.description || moment.contentHtml.replace(/<[^>]+>/g, " ").trim()}</p>
		{previewImages.length > 0 && (
			<div class:list={["diary-images mb-3 grid gap-2", `diary-images-${previewImages.length}`]}>
				{previewImages.map((image, imageIndex) => (
					<a href={getImageUrl(image)} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-(--primary)">
						<img src={getImageUrl(image)} alt={image.alt || `${title} ${imageLabel} ${imageIndex + 1}`} width={image.width} height={image.height} loading="lazy" decoding="async" class="h-auto w-full rounded-lg object-contain transition-transform duration-300 group-hover:scale-[1.02]" />
					</a>
				))}
			</div>
		)}
		{(moment.location || moment.mood) && (
			<div class="mb-3 flex flex-wrap items-center gap-3 text-xs text-black/55 dark:text-white/55">
				{moment.location && <span class="inline-flex items-center gap-1"><Icon name="material-symbols:location-on" class="h-3.5 w-3.5" />{moment.location}</span>}
				{moment.mood && <span class="inline-flex items-center gap-1"><Icon name="material-symbols:sentiment-satisfied" class="h-3.5 w-3.5" />{moodLabel}</span>}
			</div>
		)}
		{moment.tags.length > 0 && <div class="mb-4 flex flex-wrap gap-1.5">{moment.tags.slice(0, 8).map((tag) => <span class="rounded-lg bg-(--btn-regular-bg) px-2 py-1 text-xs text-black/65 dark:text-white/65">{tag}</span>)}</div>}
		<a href={detailHref} class="btn-regular inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-(--primary)">
			<Icon name="material-symbols:arrow-forward" class="h-4 w-4" />
			{viewLabel}
		</a>
	</div>
	<div class="pointer-events-none absolute inset-0 rounded-xl bg-linear-to-br from-(--primary)/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
</article>

<style is="global">
	.moment-card { animation: diary-fade-in 0.45s ease-out both; }
	.moment-card.filtered-out { display: none; }
	.diary-images-1 { grid-template-columns: minmax(0, 1fr); max-width: 28rem; }
	.diary-images-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 34rem; }
	.diary-images-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 42rem; }
	@keyframes diary-fade-in { from { opacity: 0; transform: translateY(0.75rem); } to { opacity: 1; transform: translateY(0); } }
	@media (width < 640px) { .diary-images-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
