---
import { Icon } from "astro-icon/components";
import { loadStructuredContent } from "../../../data/structured-content";
import { adaptAnnouncements } from "../../../data/wordpress-structured-adapters";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import WidgetLayout from "../common/WidgetLayout.astro";

interface Props { class?: string; style?: string; }
const announcement = adaptAnnouncements(loadStructuredContent().announcements)[0];
---

{announcement && (
	<WidgetLayout name={announcement.title || i18n(I18nKey.announcement)} id="announcement" class={Astro.props.class} style={Astro.props.style}>
		<div data-announcement-key={announcement.dismissKey}>
			<div class="whitespace-pre-line text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">{announcement.content}</div>
			<div class="flex items-center justify-between gap-3">
				<div>{announcement.link.enable && announcement.link.url && <a href={announcement.link.url} target={announcement.link.external ? "_blank" : undefined} rel={announcement.link.external ? "noopener noreferrer" : undefined} class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform">{announcement.link.text}</a>}</div>
				{announcement.closable && <button type="button" data-announcement-close class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors" aria-label={i18n(I18nKey.announcementClose)}><Icon name="fa7-solid:xmark" class="text-sm" /></button>}
			</div>
		</div>
	</WidgetLayout>
)}

<script>
	function initializeAnnouncements() {
		document.querySelectorAll<HTMLElement>("[data-announcement-key]").forEach((content) => {
			if (content.dataset.announcementBound) return;
			content.dataset.announcementBound = "true";
			const key = `jaisong1n:announcement:${content.dataset.announcementKey}`;
			const widget = content.closest<HTMLElement>('widget-layout[data-id="announcement"]');
			try { if (localStorage.getItem(key) === "closed") widget?.setAttribute("hidden", ""); } catch {}
			content.querySelector<HTMLButtonElement>("[data-announcement-close]")?.addEventListener("click", () => {
				widget?.setAttribute("hidden", "");
				try { localStorage.setItem(key, "closed"); } catch {}
			}, { once: true });
		});
	}
	document.addEventListener("astro:page-load", initializeAnnouncements);
	initializeAnnouncements();
</script>
