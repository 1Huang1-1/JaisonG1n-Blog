---
export const prerender = true;
const target = "/radar/";
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="robots" content="noindex,follow" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Redirecting</title>
	</head>
	<body>
		<p>页面已迁移到 <a href={target}>科技雷达</a>。</p>
	</body>
</html>
