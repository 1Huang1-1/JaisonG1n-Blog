---
import { Icon } from "astro-icon/components";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import LearningResourceCard from "@components/features/resources/LearningResourceCard.astro";
import { siteConfig } from "../config";
import { loadStructuredContent } from "../data/structured-content";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.learning) return Astro.redirect("/404/");
const { learningResources } = loadStructuredContent();
const types = [...new Set(learningResources.map((item) => item.type))];
const statuses = [...new Set(learningResources.map((item) => item.status))];
---

<MainGridLayout title={i18n(I18nKey.learning)} description={i18n(I18nKey.learningSubtitle)}>
	<div class="card-base px-6 py-6 sm:px-9">
		<PageHeader title={i18n(I18nKey.learning)} subtitle={i18n(I18nKey.learningSubtitle)} />
		{learningResources.length > 0 && <div class="mb-8 flex flex-wrap gap-3" data-learning-filters>
			<label class="flex items-center gap-2 text-sm"><span>{i18n(I18nKey.filterType)}</span><select data-learning-filter="type" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2"><option value="all">全部</option>{types.map((value) => <option value={value}>{value}</option>)}</select></label>
			<label class="flex items-center gap-2 text-sm"><span>{i18n(I18nKey.filterStatus)}</span><select data-learning-filter="status" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2"><option value="all">全部</option>{statuses.map((value) => <option value={value}>{value}</option>)}</select></label>
		</div>}
		<div class="grid gap-6 md:grid-cols-2" data-learning-grid>
			{learningResources.map((item) => <div data-learning-item data-type={item.type} data-status={item.status}><LearningResourceCard item={item} /></div>)}
		</div>
		{learningResources.length === 0 && <div class="py-16 text-center text-black/55 dark:text-white/55"><Icon name="material-symbols:menu-book" class="mx-auto mb-4 h-14 w-14 opacity-40" /><p>{i18n(I18nKey.learningEmpty)}</p></div>}
		{learningResources.length > 0 && <div data-learning-empty class="hidden py-16 text-center text-black/55 dark:text-white/55"><p>{i18n(I18nKey.noData)}</p></div>}
	</div>
</MainGridLayout>

<script is:inline>
	function initLearningFilters() {
		const root = document.querySelector("[data-learning-filters]");
		if (!root || root.dataset.bound === "true") return;
		root.dataset.bound = "true";
		const items = [...document.querySelectorAll("[data-learning-item]")];
		const empty = document.querySelector("[data-learning-empty]");
		const apply = () => {
			const values = Object.fromEntries([...root.querySelectorAll("select")].map((select) => [select.dataset.learningFilter, select.value]));
			let visible = 0;
			for (const item of items) {
				const show = Object.entries(values).every(([key, value]) => value === "all" || item.dataset[key] === value);
				item.classList.toggle("hidden", !show);
				if (show) visible += 1;
			}
			empty?.classList.toggle("hidden", visible !== 0);
		};
		root.addEventListener("change", apply);
		apply();
	}
	document.addEventListener("DOMContentLoaded", initLearningFilters, { once: true });
	document.addEventListener("astro:after-swap", initLearningFilters);
</script>
