---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { MomentCard } from "@components/features/diary";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../config";
import { type DiaryItem, sortDiary } from "../data/diary";
import { loadStructuredContent } from "../data/structured-content";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getStructuredDetailHref } from "../utils/structured-detail";

if (!siteConfig.featurePages.diary) return Astro.redirect("/404/");

const moments = sortDiary(loadStructuredContent().diary as DiaryItem[]);
const allTags = [...new Set(moments.flatMap((moment) => moment.tags))].sort();
const title = i18n(I18nKey.diary);
const subtitle = i18n(I18nKey.diarySubtitle);
const displayTitle = (moment: DiaryItem) =>
	moment.title.trim() || `${i18n(I18nKey.diaryUntitled)} · ${moment.date}`;
const moodLabel = (mood: DiaryItem["mood"]) =>
	mood
		? i18n(
				I18nKey[
					`diaryMood${mood[0].toUpperCase()}${mood.slice(1)}` as keyof typeof I18nKey
				],
			)
		: "";
const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.albumsFilterAll),
		icon: "material-symbols:apps",
		count: moments.length,
	},
	...allTags.map((tag) => ({
		value: tag,
		label: tag,
		count: moments.filter((moment) => moment.tags.includes(tag)).length,
	})),
];
---

<MainGridLayout title={title} description={subtitle}>
	<script is:inline src="/js/filter-tabs-handler.js"></script>
	<div class="flex w-full overflow-hidden rounded-(--radius-large)">
		<div class="card-base relative z-10 w-full overflow-hidden">
			<div class="px-6 py-6 sm:px-9">
				<div class="rounded-xl bg-linear-to-r from-(--primary) to-(--primary-dark,var(--primary)) p-5 sm:p-6">
					<div class="flex items-center justify-between gap-4">
						<div class="min-w-0">
							<h1 class="mb-1 break-words text-2xl font-bold text-white drop-shadow-sm sm:text-3xl">{title}</h1>
							<p class="break-words text-sm text-white/80 sm:text-base">{subtitle}</p>
						</div>
						<div class="shrink-0 text-center">
							<span class="block text-2xl font-bold text-white drop-shadow-sm sm:text-3xl">{moments.length}</span>
							<span class="block text-xs text-white/70 sm:text-sm">{i18n(I18nKey.diaryCount)}</span>
						</div>
					</div>
				</div>
			</div>
			<div class="px-6 pb-8 pt-2 sm:px-9">
				{moments.length > 0 && allTags.length > 0 && <div class="mb-8"><FilterTabs tabs={filterTabs} dataAttr="tags" /></div>}
				{moments.length > 0 ? (
					<div id="diary-list" class="space-y-4">
						{moments.map((moment) => <MomentCard moment={moment} title={displayTitle(moment)} detailHref={getStructuredDetailHref("diary", moment.id)} viewLabel={i18n(I18nKey.diaryViewFull)} moodLabel={moodLabel(moment.mood)} imageLabel={i18n(I18nKey.diaryImage)} />)}
					</div>
				) : (
					<div class="py-16 text-center text-black/55 dark:text-white/55">
						<Icon name="material-symbols:edit-note" class="mx-auto mb-4 h-14 w-14 opacity-40" />
						<p class="text-lg">{i18n(I18nKey.diaryEmpty)}</p>
					</div>
				)}
			</div>
		</div>
	</div>
</MainGridLayout>
