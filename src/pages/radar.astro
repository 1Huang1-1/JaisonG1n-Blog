---
import { Icon } from "astro-icon/components";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import RadarCard from "@components/features/resources/RadarCard.astro";
import { siteConfig } from "../config";
import { loadStructuredContent } from "../data/structured-content";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.radar) return Astro.redirect("/404/");
const { techRadar } = loadStructuredContent();
const domains = [...new Set(techRadar.map((item) => item.domain))];
const stages = [...new Set(techRadar.map((item) => item.stage))];
---

<MainGridLayout title={i18n(I18nKey.radar)} description={i18n(I18nKey.radarSubtitle)}>
	<div class="card-base px-6 py-6 sm:px-9">
		<PageHeader title={i18n(I18nKey.radar)} subtitle={i18n(I18nKey.radarSubtitle)} />
		{techRadar.length > 0 && <div class="mb-8 flex flex-wrap gap-3" data-radar-filters>
			<label class="flex items-center gap-2 text-sm"><span>{i18n(I18nKey.filterDomain)}</span><select data-radar-filter="domain" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2"><option value="all">全部</option>{domains.map((value) => <option value={value}>{value}</option>)}</select></label>
			<label class="flex items-center gap-2 text-sm"><span>{i18n(I18nKey.filterStage)}</span><select data-radar-filter="stage" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2"><option value="all">全部</option>{stages.map((value) => <option value={value}>{value}</option>)}</select></label>
		</div>}
		<div class="grid gap-6 md:grid-cols-2" data-radar-grid>
			{techRadar.map((item) => <div data-radar-item data-domain={item.domain} data-stage={item.stage}><RadarCard item={item} /></div>)}
		</div>
		{techRadar.length === 0 && <div class="py-16 text-center text-black/55 dark:text-white/55"><Icon name="material-symbols:radar" class="mx-auto mb-4 h-14 w-14 opacity-40" /><p>{i18n(I18nKey.radarEmpty)}</p></div>}
		{techRadar.length > 0 && <div data-radar-empty class="hidden py-16 text-center text-black/55 dark:text-white/55"><p>{i18n(I18nKey.noData)}</p></div>}
	</div>
</MainGridLayout>

<script is:inline>
	function initRadarFilters() {
		const root = document.querySelector("[data-radar-filters]");
		if (!root || root.dataset.bound === "true") return;
		root.dataset.bound = "true";
		const items = [...document.querySelectorAll("[data-radar-item]")];
		const empty = document.querySelector("[data-radar-empty]");
		const apply = () => {
			const values = Object.fromEntries([...root.querySelectorAll("select")].map((select) => [select.dataset.radarFilter, select.value]));
			let visible = 0;
			for (const item of items) {
				const show = Object.entries(values).every(([key, value]) => value === "all" || item.dataset[key] === value);
				item.classList.toggle("hidden", !show);
				if (show) visible += 1;
			}
			empty?.classList.toggle("hidden", visible !== 0);
		};
		root.addEventListener("change", apply);
		apply();
	}
	document.addEventListener("DOMContentLoaded", initRadarFilters, { once: true });
	document.addEventListener("astro:after-swap", initRadarFilters);
</script>
